# VITE_SUPABASE_URL: URL проекта Supabase
VITE_SUPABASE_URL=

# VITE_SUPABASE_ANON_KEY: публичный anon-ключ проекта Supabase
VITE_SUPABASE_ANON_KEY=

# VITE_YOOMONEY_RECEIVER: номер кошелька ЮMoney для приёма оплаты публикации (100 ₽)
# Здесь намеренно заглушка. Сам номер кошелька не секрет — его видит любой
# плательщик, — но в примере конфигурации боевому значению не место: оно
# копируется в чужие .env при форке и попадает в поиск по репозиторию.
# Реальное значение возьмите в кабинете ЮMoney и впишите в .env (он в .gitignore).
VITE_YOOMONEY_RECEIVER=41001XXXXXXXXXX
